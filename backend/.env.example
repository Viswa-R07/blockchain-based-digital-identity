# ==============================================================================
# Hyperledger Fabric Digital Identity REST API Backend Environment Configuration
# Milestone 7 - Sample Configuration
# ==============================================================================

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# API Authentication Secret / Keys for prototype access control
# Production should use OAuth 2.0 / OIDC with asymmetric JWT signatures & mTLS
API_KEY_GOV=gov-admin-secret-key-12345
API_KEY_UNI=uni-registrar-secret-key-12345
API_KEY_BANK=bank-compliance-secret-key-12345
API_KEY_EMP=emp-hr-secret-key-12345
API_KEY_VERIFIER=verifier-public-secret-key-12345

# Channel & Chaincode Names
FABRIC_CHANNEL_NAME=identity-channel
FABRIC_CHAINCODE_NAME=identity-registry

# Base Directory for Organizations Crypto Material (Relative to backend/ or absolute)
CRYPTO_BASE_PATH=../network/organizations/peerOrganizations

# ------------------------------------------------------------------------------
# GovMSP (Government Identity Authority)
# ------------------------------------------------------------------------------
GOV_PEER_ENDPOINT=localhost:7051
GOV_PEER_HOST_OVERRIDE=peer0.gov.identity.example.com
GOV_TLS_CERT_PATH=../network/organizations/peerOrganizations/gov.identity.example.com/peers/peer0.gov.identity.example.com/tls/ca.crt
GOV_USER_CERT_PATH=../network/organizations/peerOrganizations/gov.identity.example.com/users/User1@gov.identity.example.com/msp/signcerts/cert.pem
GOV_KEYSTORE_DIR=../network/organizations/peerOrganizations/gov.identity.example.com/users/User1@gov.identity.example.com/msp/keystore

# ------------------------------------------------------------------------------
# UniversityMSP (Higher Education Registrar)
# ------------------------------------------------------------------------------
UNI_PEER_ENDPOINT=localhost:8051
UNI_PEER_HOST_OVERRIDE=peer0.university.example.com
UNI_TLS_CERT_PATH=../network/organizations/peerOrganizations/university.example.com/peers/peer0.university.example.com/tls/ca.crt
UNI_USER_CERT_PATH=../network/organizations/peerOrganizations/university.example.com/users/User1@university.example.com/msp/signcerts/cert.pem
UNI_KEYSTORE_DIR=../network/organizations/peerOrganizations/university.example.com/users/User1@university.example.com/msp/keystore

# ------------------------------------------------------------------------------
# BankMSP (Financial & KYC Verification Authority)
# ------------------------------------------------------------------------------
BANK_PEER_ENDPOINT=localhost:9051
BANK_PEER_HOST_OVERRIDE=peer0.bank.example.com
BANK_TLS_CERT_PATH=../network/organizations/peerOrganizations/bank.example.com/peers/peer0.bank.example.com/tls/ca.crt
BANK_USER_CERT_PATH=../network/organizations/peerOrganizations/bank.example.com/users/User1@bank.example.com/msp/signcerts/cert.pem
BANK_KEYSTORE_DIR=../network/organizations/peerOrganizations/bank.example.com/users/User1@bank.example.com/msp/keystore

# ------------------------------------------------------------------------------
# EmployerMSP (Employment Verification Authority)
# ------------------------------------------------------------------------------
EMP_PEER_ENDPOINT=localhost:10051
EMP_PEER_HOST_OVERRIDE=peer0.employer.example.com
EMP_TLS_CERT_PATH=../network/organizations/peerOrganizations/employer.example.com/peers/peer0.employer.example.com/tls/ca.crt
EMP_USER_CERT_PATH=../network/organizations/peerOrganizations/employer.example.com/users/User1@employer.example.com/msp/signcerts/cert.pem
EMP_KEYSTORE_DIR=../network/organizations/peerOrganizations/employer.example.com/users/User1@employer.example.com/msp/keystore

# ------------------------------------------------------------------------------
# Milestone 8 - Off-Chain Encrypted Credential Storage Configuration
# DEVELOPMENT / RESEARCH PROTOTYPE KEY MANAGEMENT (Do not use for production)
# ------------------------------------------------------------------------------
STORAGE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_KEY_ID=key-dev-master-01
CREDENTIAL_STORAGE_PATH=./storage/credentials

