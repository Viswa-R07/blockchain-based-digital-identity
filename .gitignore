# ==============================================================================
# .gitignore for Hyperledger Fabric Digital Identity Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cryptographic Material & Private Keys (Generated Runtime Secrets)
# ------------------------------------------------------------------------------
# Private keys and keystores generated by Fabric CA / cryptogen
*_sk
*.key
*.priv
**/keystore/
**/msp/keystore/
**/tls/*.key

# Generated organization crypto materials (Orderers & Peers)
# WARNING: Generated at runtime via network/organizations/registerEnroll.sh
network/organizations/ordererOrganizations/
network/organizations/peerOrganizations/

# Fabric CA runtime directories (server DB, keys, generated certs & configs)
network/organizations/fabric-ca/
*.db
**/fabric-ca-server.db
**/IssuerPublicKey
**/IssuerRevocationPublicKey

# Ensure enrollment generator script is always preserved
!network/organizations/registerEnroll.sh

# ------------------------------------------------------------------------------
# 2. Channel Artifacts & Packaged Binaries (Generated Ledger/Channel State)
# ------------------------------------------------------------------------------
# Genesis blocks, channel configuration blocks, update transactions
*.block
*.tx
*.pb
network/channel-artifacts/*.block
network/channel-artifacts/*.tx
network/channel-artifacts/*.pb
network/channel-artifacts/anchor_update/
network/channel-artifacts/resilience_test/

# Packaged chaincode tarball archives
*.tar.gz
*.tgz
network/channel-artifacts/chaincode/*.tar.gz
chaincode/**/*.tar.gz

# ------------------------------------------------------------------------------
# 3. Chaincode Dependencies & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/

# TypeScript build info and npm/yarn logs
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secret Configuration Files
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
secrets/


# ------------------------------------------------------------------------------
# 4b. Milestone 8 Off-Chain Encrypted Credential Storage
# ------------------------------------------------------------------------------
storage/
**/storage/
backend/storage/
*.enc
*.enc.json
*.tmp


# ------------------------------------------------------------------------------
# 5. Fabric Platform Binaries & Samples (Downloaded via bootstrap)
# ------------------------------------------------------------------------------
fabric-samples/
bin/
config/core.yaml
config/orderer.yaml

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
